{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/knowledge-tester-question-bank.schema.json",
  "title": "Knowledge Tester Question Bank",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "prompt",
      "options",
      "correct_answers",
      "explanation"
    ],
    "properties": {
      "id": {
        "type": "integer",
        "minimum": 1
      },
      "prompt": {
        "type": "string",
        "minLength": 1
      },
      "options": {
        "type": "array",
        "minItems": 2,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "correct_answers": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "integer",
          "minimum": 0
        }
      },
      "explanation": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

